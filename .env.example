# === Обязательно ===
ANTHROPIC_API_KEY=sk-ant-...
# Пароль для веб-интерфейса и API (обязательно, если сервер доступен из интернета)
OFFICE_ADMIN_TOKEN=придумайте-длинный-пароль

# === Почта (агенты переписываются с людьми) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password
SMTP_FROM=AI Office <you@example.com>
IMAP_HOST=imap.gmail.com
IMAP_USER=you@example.com
IMAP_PASSWORD=app-password

# === Telegram (бот для переписки + канал для постов) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel

# === Продажи (Stripe Payment Links) ===
STRIPE_API_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
